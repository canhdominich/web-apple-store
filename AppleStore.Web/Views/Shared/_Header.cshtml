@inject ICartService CartService
@inject ICartSessionService CartSession
@{ var cartCount = await CartService.CountAsync(CartSession.GetCartKey()); }
<header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg bg-white border-bottom">
        <div class="container py-2">
            <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index"><span class="brand-dot"></span>apple<span>store</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto gap-lg-3">
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index" asp-route-categoryId="1">iPhone</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index" asp-route-categoryId="2">Mac</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index" asp-route-categoryId="3">iPad</a></li>
                    <li class="nav-item"><a class="nav-link" href="#why-us">Dịch vụ</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <a class="icon-link" asp-controller="Product" asp-action="Index" aria-label="Tìm kiếm"><i class="bi bi-search"></i></a>
                    @if (Context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="icon-link" href="#" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tài khoản"><i class="bi bi-person"></i></a>
                            <ul class="dropdown-menu dropdown-menu-end app-dropdown">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i>Tài khoản</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Index"><i class="bi bi-receipt"></i>Đơn hàng</a></li>
                                @if (Context.User.IsInRole("Admin")) { <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i>Quản trị</a></li> }
                                <li><hr class="dropdown-divider" /></li>
                                <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i>Đăng xuất</button></form></li>
                            </ul>
                        </div>
                    }
                    else { <a class="icon-link" asp-controller="Account" asp-action="Login"><i class="bi bi-person"></i></a> }
                    <a class="icon-link position-relative" asp-controller="Cart" asp-action="Index"><i class="bi bi-bag"></i><span id="cart-count" class="cart-badge">@cartCount</span></a>
                </div>
            </div>
        </div>
    </nav>
</header>
