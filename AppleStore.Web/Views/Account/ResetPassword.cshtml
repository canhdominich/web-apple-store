@model ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu · Apple Store"; }
<div class="auth-page"><div class="auth-card"><div class="text-center mb-4"><div class="auth-logo"><i class="bi bi-shield-lock"></i></div><h1>Đặt lại mật khẩu</h1><p class="text-muted">Tạo mật khẩu mới cho tài khoản của bạn.</p></div><form asp-action="ResetPassword" method="post"><input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control form-control-lg" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control form-control-lg" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div><button class="btn btn-primary btn-lg w-100">Đặt lại mật khẩu</button></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
