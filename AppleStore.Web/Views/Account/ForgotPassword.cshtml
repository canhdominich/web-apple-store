@{ ViewData["Title"] = "Quên mật khẩu · Apple Store"; }
<div class="auth-page"><div class="auth-card"><div class="text-center mb-4"><div class="auth-logo"><i class="bi bi-envelope"></i></div><h1>Quên mật khẩu?</h1><p class="text-muted">Nhập email để nhận hướng dẫn đặt lại mật khẩu.</p></div><form asp-action="ForgotPassword" method="post"><label class="form-label">Email</label><input class="form-control form-control-lg mb-3" type="email" name="email" required /><button class="btn btn-primary btn-lg w-100">Gửi hướng dẫn</button></form>@if (TempData["ResetLink"] is string link) { <div class="alert alert-info small mt-4 mb-0">Development reset link: <a href="@link">Mở trang đặt lại mật khẩu</a></div> }<p class="text-center mt-4 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left me-1"></i> Quay lại đăng nhập</a></p></div></div>
