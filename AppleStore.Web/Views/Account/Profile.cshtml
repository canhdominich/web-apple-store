@model ApplicationUser
@{ ViewData["Title"] = "Tài khoản · Apple Store"; }
<div class="page-hero compact"><div class="container"><div class="eyebrow">Tài khoản của tôi</div><h1>Xin chào, <em>@Model.FullName.</em></h1></div></div><section class="section-space pt-4"><div class="container"><div class="row g-4"><div class="col-lg-3"><div class="account-nav"><a class="active" asp-action="Profile"><i class="bi bi-person"></i> Thông tin cá nhân</a><a asp-controller="Order" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng của tôi</a><a asp-action="ChangePassword"><i class="bi bi-shield-lock"></i> Đổi mật khẩu</a></div></div><div class="col-lg-7"><div class="checkout-card"><h2 class="h5 mb-4">Thông tin cá nhân</h2><form asp-action="Profile" method="post"><div class="mb-3"><label class="form-label">Họ và tên</label><input class="form-control" name="fullName" value="@Model.FullName" required /></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" value="@Model.Email" disabled /></div><div class="mb-3"><label class="form-label">Số điện thoại</label><input class="form-control" name="phoneNumber" value="@Model.PhoneNumber" required /></div><div class="mb-4"><label class="form-label">Địa chỉ</label><textarea class="form-control" name="address" rows="3" required>@Model.Address</textarea></div><button class="btn btn-primary">Lưu thay đổi</button></form></div></div></div></div></section>
