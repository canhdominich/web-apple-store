@model AppleStore.Web.Controllers.HomeViewModel
@{ ViewData["Title"] = "Apple Store · Công nghệ cho nhịp sống mới"; }
<section class="hero-section"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-6"><div class="eyebrow"><span></span> Apple Store Việt Nam</div><h1>Công nghệ tốt hơn.<br /><em>Sống khác đi.</em></h1><p class="hero-lead">Khám phá hệ sinh thái Apple chính hãng với trải nghiệm mua sắm đơn giản, dịch vụ tận tâm và giao hàng nhanh.</p><div class="d-flex gap-3 flex-wrap"><a class="btn btn-primary btn-lg" asp-controller="Product" asp-action="Index">Khám phá sản phẩm <i class="bi bi-arrow-up-right ms-2"></i></a><a class="btn btn-link btn-lg" href="#featured">Xem sản phẩm nổi bật <i class="bi bi-arrow-down ms-2"></i></a></div><div class="hero-metrics mt-5"><div><strong>15+</strong><span>Sản phẩm<br />chính hãng</span></div><div><strong>24h</strong><span>Giao hàng<br />nội thành</span></div><div><strong>1:1</strong><span>Tư vấn<br />tận tâm</span></div></div></div><div class="col-lg-6"><div class="hero-art"><div class="hero-glow"></div><div class="hero-device device-back"></div><div class="hero-device device-front"><div class="device-screen"><span>Pro.</span><b>Titan tự nhiên</b></div></div><div class="floating-card"><i class="bi bi-patch-check"></i><span>Chính hãng<br /><strong>minh bạch</strong></span></div></div></div></div></div></section>
<section class="category-strip"><div class="container"><div class="section-heading d-flex justify-content-between align-items-end mb-4"><div><div class="eyebrow">Bộ sưu tập</div><h2>Chọn theo phong cách của bạn</h2></div><a class="text-link" asp-controller="Product" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a></div><div class="row g-3">@foreach (var category in Model.Categories) { <div class="col-6 col-md-4 col-lg-2"><a class="category-card" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"><span class="category-icon"><i class="bi @(category.Name switch { "iPhone" => "bi-phone", "Mac" => "bi-laptop", "iPad" => "bi-tablet", "Apple Watch" => "bi-smartwatch", "AirPods" => "bi-earbuds", _ => "bi-usb-plug" })"></i></span><strong>@category.Name</strong><span class="small text-muted">Khám phá <i class="bi bi-arrow-up-right"></i></span></a></div> }</div></div></section>
<section id="featured" class="section-space"><div class="container"><div class="section-heading mb-4"><div class="eyebrow">Được yêu thích</div><h2>Sản phẩm nổi bật</h2><p>Những lựa chọn được tuyển chọn cho trải nghiệm Apple trọn vẹn.</p></div><div class="row g-3 g-lg-4">@foreach (var product in Model.FeaturedProducts) { <div class="col-12 col-sm-6 col-lg-3"><partial name="_ProductCard" model="product" /></div> }</div></div></section>
<section id="why-us" class="trust-section"><div class="container"><div class="row g-4"><div class="col-md-4"><div class="trust-item"><i class="bi bi-patch-check"></i><div><h3>Chính hãng 100%</h3><p>Sản phẩm có nguồn gốc rõ ràng, bảo hành minh bạch.</p></div></div></div><div class="col-md-4"><div class="trust-item"><i class="bi bi-box-seam"></i><div><h3>Giao hàng an tâm</h3><p>Đóng gói cẩn thận, theo dõi đơn hàng từng chặng.</p></div></div></div><div class="col-md-4"><div class="trust-item"><i class="bi bi-headset"></i><div><h3>Hỗ trợ tận tâm</h3><p>Đội ngũ tư vấn giúp bạn chọn đúng sản phẩm cần dùng.</p></div></div></div></div></div></section>
<section class="section-space"><div class="container"><div class="section-heading mb-4"><div class="eyebrow">Mới cập bến</div><h2>Khám phá thêm</h2></div><div class="row g-3 g-lg-4">@foreach (var product in Model.LatestProducts) { <div class="col-12 col-sm-6 col-lg-3"><partial name="_ProductCard" model="product" /></div> }</div></div></section>
