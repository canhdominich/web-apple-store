@model PaymentResultViewModel
@{ ViewData["Title"] = "Thanh toán thất bại · Apple Store"; }
<div class="result-page"><div class="result-icon failed"><i class="bi bi-x-lg"></i></div><div class="eyebrow">Thanh toán VNPay</div><h1>Thanh toán <em>chưa hoàn tất.</em></h1><p>@(string.IsNullOrWhiteSpace(Model.Message) ? "Giao dịch không thành công hoặc đã bị hủy." : Model.Message)</p>@if (Model.Order.Id > 0) { <div class="result-summary"><div><span>Mã đơn hàng</span><strong>#@Model.Order.OrderCode</strong></div><div><span>Trạng thái</span><strong>Thất bại</strong></div><div><span>Giao dịch</span><strong>@(Model.Payment?.TransactionNo ?? "Chưa có")</strong></div></div><div class="d-flex justify-content-center gap-3 flex-wrap mt-4"><form asp-controller="Checkout" asp-action="PayAgain" method="post"><input type="hidden" name="id" value="@Model.Order.Id" /><button class="btn btn-primary"><i class="bi bi-arrow-repeat me-2"></i>Thử lại</button></form><a class="btn btn-outline-dark" asp-controller="Order" asp-action="Details" asp-route-id="@Model.Order.Id">Xem đơn hàng</a></div> } else { <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Về trang chủ</a> }</div>
