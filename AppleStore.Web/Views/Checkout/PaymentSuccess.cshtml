@model PaymentResultViewModel
@{ ViewData["Title"] = "Thanh toán thành công · Apple Store"; }
<div class="result-page"><div class="result-icon success"><i class="bi bi-check2"></i></div><div class="eyebrow">Thanh toán VNPay</div><h1>Thanh toán <em>thành công.</em></h1><p>Giao dịch của bạn đã được xác thực và ghi nhận an toàn.</p><div class="result-summary"><div><span>Mã đơn hàng</span><strong>#@Model.Order.OrderCode</strong></div><div><span>Số tiền</span><strong>@Model.Order.TotalAmount.ToMoney()</strong></div><div><span>Mã giao dịch</span><strong>@(Model.Payment?.TransactionNo ?? Model.Order.TransactionNo ?? "Chưa có")</strong></div><div><span>Trạng thái</span><strong>@Model.Order.PaymentStatus.ToPaymentStatusText()</strong></div></div><div class="d-flex justify-content-center gap-3 flex-wrap mt-4"><a class="btn btn-primary" asp-controller="Order" asp-action="Details" asp-route-id="@Model.Order.Id">Xem đơn hàng</a><a class="btn btn-outline-dark" asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a></div></div>
