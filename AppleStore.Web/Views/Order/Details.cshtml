@model Order
@{ ViewData["Title"] = $"Đơn hàng #{Model.OrderCode}"; var canRetry = Model.PaymentMethod == PaymentMethod.VNPay && Model.PaymentStatus is (PaymentStatus.Failed or PaymentStatus.Pending) && Model.OrderStatus is not (OrderStatus.Cancelled or OrderStatus.Completed); }
<div class="page-hero compact"><div class="container"><a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Đơn hàng của tôi</a><h1 class="mt-3">Đơn hàng <em>#@Model.OrderCode</em></h1></div></div><section class="section-space pt-4"><div class="container"><div class="row g-4"><div class="col-lg-8"><div class="checkout-card"><div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><div class="eyebrow">Đặt ngày @Model.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div><h2 class="h5 mt-2 mb-0">Chi tiết sản phẩm</h2></div><partial name="_OrderStatusBadge" model="Model.OrderStatus" /></div>@foreach (var item in Model.OrderDetails) { <div class="order-detail-item"><img src="/images/products/placeholder.svg" alt="" /><div class="flex-grow-1"><strong>@item.ProductName</strong><span>@item.VariantName · @item.SKU</span><small>Số lượng: @item.Quantity</small></div><strong>@item.TotalPrice.ToMoney()</strong></div> }<hr /><div class="summary-line"><span>Tạm tính</span><span>@Model.Subtotal.ToMoney()</span></div><div class="summary-line"><span>Phí giao hàng</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToMoney())</span></div><div class="summary-total mt-2"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToMoney()</strong></div></div><div class="checkout-card mt-4"><h2 class="h5 mb-3">Lịch sử thanh toán</h2>@foreach (var payment in Model.Payments.OrderByDescending(x => x.CreatedDate)) { <div class="payment-history"><div><strong>@payment.Provider · @payment.TxnRef</strong><small>@payment.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm") · @payment.TransactionNo</small></div><partial name="_PaymentStatusBadge" model="payment.Status" /></div> }@if (canRetry) { <form asp-controller="Checkout" asp-action="PayAgain" method="post" class="mt-4"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary"><i class="bi bi-arrow-repeat me-2"></i>Thử thanh toán lại</button></form> }</div></div><div class="col-lg-4"><div class="summary-card"><h2 class="h5 mb-4">Thông tin nhận hàng</h2><dl class="info-list"><dt>Người nhận</dt><dd>@Model.CustomerName</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Số điện thoại</dt><dd>@Model.PhoneNumber</dd><dt>Địa chỉ</dt><dd>@Model.ShippingAddress</dd><dt>Thanh toán</dt><dd>@(Model.PaymentMethod == PaymentMethod.COD ? "Thanh toán khi nhận hàng" : "VNPay")</dd></dl><a class="btn btn-outline-dark w-100 mt-3" asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a></div></div></div></div></section>
