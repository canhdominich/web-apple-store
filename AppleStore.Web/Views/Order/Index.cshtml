@model IReadOnlyList<Order>
@{ ViewData["Title"] = "Đơn hàng · Apple Store"; }
<div class="page-hero compact"><div class="container"><div class="eyebrow">Tài khoản của tôi</div><h1>Đơn hàng <em>của bạn.</em></h1></div></div><section class="section-space pt-4"><div class="container">@if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-receipt"></i><h3>Bạn chưa có đơn hàng</h3><p>Những sản phẩm tuyệt vời đang chờ bạn khám phá.</p><a class="btn btn-primary" asp-controller="Product" asp-action="Index">Mua sắm ngay</a></div> } else { <div class="order-list">@foreach (var order in Model) { <a class="order-row" asp-action="Details" asp-route-id="@order.Id"><div><strong>#@order.OrderCode</strong><span>@order.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm") · @order.OrderDetails.Count sản phẩm</span></div><div class="text-end"><strong>@order.TotalAmount.ToMoney()</strong><div class="mt-1"><partial name="_OrderStatusBadge" model="order.OrderStatus" /> <partial name="_PaymentStatusBadge" model="order.PaymentStatus" /></div></div><i class="bi bi-chevron-right"></i></a> }</div> }</div></section>
