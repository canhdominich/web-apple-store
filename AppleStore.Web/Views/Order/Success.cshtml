@model Order
@{ ViewData["Title"] = "Đặt hàng thành công · Apple Store"; }
<div class="result-page"><div class="result-icon success"><i class="bi bi-check2"></i></div><div class="eyebrow">Cảm ơn bạn đã tin chọn</div><h1>Đặt hàng <em>thành công.</em></h1><p>Đơn hàng <strong>#@Model.OrderCode</strong> đã được ghi nhận. Chúng tôi sẽ liên hệ để xác nhận trong thời gian sớm nhất.</p><div class="result-summary"><div><span>Tổng thanh toán</span><strong>@Model.TotalAmount.ToMoney()</strong></div><div><span>Thanh toán</span><strong>@(Model.PaymentMethod == PaymentMethod.COD ? "COD" : "VNPay")</strong></div><div><span>Trạng thái</span><strong>@Model.OrderStatus.ToOrderStatusText()</strong></div></div><div class="d-flex justify-content-center gap-3 flex-wrap mt-4"><a class="btn btn-primary" asp-action="Details" asp-route-id="@Model.Id">Xem đơn hàng</a><a class="btn btn-outline-dark" asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a></div></div>
