@model ProductDetailViewModel
@{ ViewData["Title"] = Model.Product.Name; var first = Model.Product.Variants.FirstOrDefault(); }
<div class="container section-space pt-4"><nav class="breadcrumb small"><a asp-action="Index">Sản phẩm</a><span>/</span><span>@Model.Product.Name</span></nav><div class="row g-5 align-items-start"><div class="col-lg-6"><div class="detail-image"><span class="product-badge">Apple Store selection</span><img id="detail-image" src="@(Model.Product.ImageThumbnail ?? "/images/products/placeholder.svg")" alt="@Model.Product.Name" /></div></div><div class="col-lg-6"><div class="eyebrow">@Model.Product.Category?.Name</div><h1 class="detail-title">@Model.Product.Name</h1><p class="detail-description">@Model.Product.Description</p><div class="detail-price" id="detail-price">@((first?.Price ?? Model.Product.BasePrice).ToMoney())</div><div class="detail-divider"></div><form asp-controller="Cart" asp-action="Add" method="post" class="add-detail-form"><label class="form-label fw-semibold">Chọn phiên bản</label><div class="variant-grid">@foreach (var variant in Model.Product.Variants) { <label class="variant-option"><input type="radio" name="VariantId" value="@variant.Id" data-price="@variant.Price.ToMoneyNumber()" data-stock="@variant.StockQuantity" @(variant.Id == first?.Id ? "checked" : "") /><span><b>@variant.Color</b><small>@variant.Storage · @variant.StockQuantity sản phẩm</small></span></label> }</div><div class="d-flex align-items-end gap-3 mt-4"><div><label class="form-label fw-semibold">Số lượng</label><input class="form-control quantity-input" type="number" name="Quantity" value="1" min="1" max="@(first?.StockQuantity ?? 1)" /></div><button class="btn btn-primary btn-lg flex-grow-1" type="submit"><i class="bi bi-bag-plus me-2"></i>Thêm vào giỏ</button></div></form><div class="detail-perks mt-5"><span><i class="bi bi-check-circle"></i> Bảo hành chính hãng</span><span><i class="bi bi-truck"></i> Giao hàng toàn quốc</span><span><i class="bi bi-shield-check"></i> Thanh toán an toàn</span></div></div></div></div><section class="container pb-5"><div class="section-heading mb-4"><div class="eyebrow">Bạn có thể thích</div><h2>Sản phẩm liên quan</h2></div><div class="row g-3 g-lg-4">@foreach (var product in Model.RelatedProducts) { <div class="col-12 col-sm-6 col-lg-3"><partial name="_ProductCard" model="product" /></div> }</div></section>
@section Scripts { <script src="~/js/product.js" asp-append-version="true"></script> }
