@model ProductListViewModel
@{
    ViewData["Title"] = "Sản phẩm · Apple Store";
    var currentSort = string.IsNullOrWhiteSpace(Model.Sort) ? "newest" : Model.Sort;
    var sortOptions = new (string Value, string Label)[]
    {
        ("newest", "Mới nhất"),
        ("price-asc", "Giá thấp đến cao"),
        ("price-desc", "Giá cao đến thấp"),
        ("name", "Tên A-Z")
    };
    var selectedSort = sortOptions.FirstOrDefault(option => string.Equals(option.Value, currentSort, StringComparison.OrdinalIgnoreCase));

    if (string.IsNullOrEmpty(selectedSort.Value))
    {
        selectedSort = sortOptions[0];
        currentSort = selectedSort.Value;
    }
}
<div class="page-hero"><div class="container"><div class="eyebrow">Danh mục sản phẩm</div><h1>Tìm món đồ <em>đúng gu.</em></h1><p>Thiết bị Apple cho công việc, sáng tạo và mọi khoảnh khắc.</p></div></div>
<section class="section-space pt-4"><div class="container"><div class="row g-4"><aside class="col-lg-3"><form class="filter-panel" method="get"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h5 mb-0">Bộ lọc</h2><a class="small text-muted" asp-action="Index">Xóa lọc</a></div><label class="form-label">Tìm kiếm</label><div class="input-group mb-4"><input class="form-control" name="search" value="@Model.Search" placeholder="iPhone, MacBook" /><button class="btn btn-dark"><i class="bi bi-search"></i></button></div><label class="form-label">Danh mục</label><select class="form-select mb-4" name="categoryId"><option value="">Tất cả danh mục</option>@foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }</select><label class="form-label">Khoảng giá (₫)</label><div class="row g-2 mb-4"><div class="col-6"><input class="form-control" type="number" name="minPrice" value="@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToMoneyValue() : string.Empty)" placeholder="Từ" /></div><div class="col-6"><input class="form-control" type="number" name="maxPrice" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToMoneyValue() : string.Empty)" placeholder="Đến" /></div></div><label class="form-label">Màu sắc</label><input class="form-control mb-4" name="color" value="@Model.Color" placeholder="Ví dụ: Titan đen" /><label class="form-label">Dung lượng</label><input class="form-control mb-4" name="storage" value="@Model.Storage" placeholder="Ví dụ: 256GB" /><button class="btn btn-dark w-100">Áp dụng bộ lọc</button></form></aside><div class="col-lg-9"><div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4"><p class="mb-0 text-muted">Hiển thị <strong class="text-dark">@Model.TotalItems</strong> sản phẩm</p><div class="ant-dropdown sort-dropdown" data-ant-dropdown data-input="#sort-value" data-submit-form="#sort-form"><button class="ant-dropdown-trigger" type="button" aria-haspopup="listbox" aria-expanded="false"><span data-ant-dropdown-label>@selectedSort.Label</span><i class="bi bi-chevron-down" aria-hidden="true"></i></button><div class="ant-dropdown-panel" role="listbox" aria-label="Sắp xếp sản phẩm">@foreach (var option in sortOptions) { var isSelected = string.Equals(option.Value, currentSort, StringComparison.OrdinalIgnoreCase); <button class="ant-dropdown-item @(isSelected ? "is-selected" : "")" type="button" role="option" data-value="@option.Value" data-label="@option.Label" aria-selected="@(isSelected ? "true" : "false")"><span>@option.Label</span><i class="bi bi-check ant-dropdown-item-check" aria-hidden="true"></i></button> }</div></div><form id="sort-form" method="get"><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="categoryId" value="@Model.CategoryId" /><input type="hidden" name="minPrice" value="@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToMoneyValue() : string.Empty)" /><input type="hidden" name="maxPrice" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToMoneyValue() : string.Empty)" /><input type="hidden" name="color" value="@Model.Color" /><input type="hidden" name="storage" value="@Model.Storage" /><input type="hidden" name="sort" id="sort-value" value="@currentSort" /></form></div>@if (Model.Products.Count == 0) { <div class="empty-state"><i class="bi bi-search"></i><h3>Chưa tìm thấy sản phẩm</h3><p>Thử thay đổi từ khóa hoặc bộ lọc của bạn.</p></div> } else { <div class="row g-3 g-lg-4 product-grid">@foreach (var product in Model.Products) { <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12"><partial name="_ProductCard" model="product" /></div> }</div>@if (Model.TotalPages > 1) { <nav class="mt-5"><ul class="pagination justify-content-center">@for (var i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-sort="@Model.Sort">@i</a></li> }</ul></nav> }}</div></div></div></section>
