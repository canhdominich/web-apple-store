@model IReadOnlyList<Category>
@{ ViewData["Title"] = "Danh mục"; }
<div class="admin-toolbar"><form class="search-admin"><i class="bi bi-search"></i><input name="search" value="@Context.Request.Query["search"]" placeholder="Tìm danh mục" /></form><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Thêm danh mục</a></div><div class="admin-card table-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tên danh mục</th><th>Slug</th><th>Sản phẩm</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong><small>@item.Description</small></td><td><code>@item.Slug</code></td><td>@item.Products.Count</td><td><span class="admin-status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Đang hoạt động" : "Đã tắt")</span></td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a><form class="d-inline" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-light" title="Bật/tắt"><i class="bi bi-power"></i></button></form></td></tr> }</tbody></table></div></div>
