@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-muted mb-0">Tổng quan hoạt động cửa hàng</p></div><span class="admin-date"><i class="bi bi-calendar3 me-2"></i>@DateTime.UtcNow.ToVietnamTime().ToString("dd/MM/yyyy")</span></div><div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="metric-card"><span>Tổng sản phẩm</span><strong>@Model.TotalProducts</strong><i class="bi bi-box-seam"></i><small>đang kinh doanh</small></div></div><div class="col-6 col-xl-3"><div class="metric-card"><span>Khách hàng</span><strong>@Model.TotalCustomers</strong><i class="bi bi-people"></i><small>tài khoản hoạt động</small></div></div><div class="col-6 col-xl-3"><div class="metric-card"><span>Đơn hàng</span><strong>@Model.TotalOrders</strong><i class="bi bi-receipt"></i><small>@Model.OrdersToday đơn hôm nay</small></div></div><div class="col-6 col-xl-3"><div class="metric-card accent"><span>Doanh thu</span><strong>@Model.Revenue.ToMoney()</strong><i class="bi bi-graph-up-arrow"></i><small>đơn đã thanh toán</small></div></div></div><div class="row g-4"><div class="col-xl-8"><div class="admin-card"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="h6 mb-1">Doanh thu 7 ngày</h2><span class="text-muted small">Chỉ tính đơn đã thanh toán</span></div><span class="admin-pill"><i class="bi bi-arrow-up-right"></i> Tổng quan</span></div><canvas id="revenueChart" height="110"></canvas></div></div><div class="col-xl-4"><div class="admin-card h-100"><div class="d-flex justify-content-between mb-3"><h2 class="h6">Sản phẩm bán chạy</h2><i class="bi bi-three-dots"></i></div>@foreach (var item in Model.TopProducts) { <div class="top-product"><span class="rank">@(Model.TopProducts.IndexOf(item) + 1)</span><div class="flex-grow-1"><strong>@item.Name</strong><small>@item.Quantity sản phẩm</small></div><i class="bi bi-arrow-up-right text-success"></i></div> }@if (Model.TopProducts.Count == 0) { <p class="text-muted small">Chưa có dữ liệu bán hàng.</p> }</div></div><div class="col-md-4"><div class="quick-card"><i class="bi bi-hourglass-split"></i><div><span>Đơn đang chờ</span><strong>@Model.PendingOrders</strong></div><a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Pending"><i class="bi bi-arrow-up-right"></i></a></div></div><div class="col-md-4"><div class="quick-card"><i class="bi bi-exclamation-triangle"></i><div><span>Sắp hết hàng</span><strong>@Model.LowStock</strong></div><a asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="bi bi-arrow-up-right"></i></a></div></div></div>
@section Scripts { <script>const rootStyles=getComputedStyle(document.documentElement);const chartPrimary=rootStyles.getPropertyValue('--color-primary').trim();const chartGrid=rootStyles.getPropertyValue('--admin-border').trim();new Chart(document.getElementById('revenueChart'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenuePoints.Select(x=>x.Label))),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenuePoints.Select(x=>x.Value))),borderColor:chartPrimary,backgroundColor:'rgba(0,113,227,.08)',fill:true,tension:.4,pointRadius:3,pointBackgroundColor:chartPrimary}]},options:{plugins:{legend:{display:false}},scales:{y:{ticks:{callback:value=>new Intl.NumberFormat('vi-VN',{notation:'compact'}).format(value)+'₫'},grid:{color:chartGrid}},x:{grid:{display:false}}}}});</script> }
