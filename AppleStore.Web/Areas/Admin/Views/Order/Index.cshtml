@model IReadOnlyList<Order>
@{ ViewData["Title"] = "Đơn hàng"; }
<div class="admin-toolbar"><form class="search-admin flex-grow-1"><i class="bi bi-search"></i><input name="search" value="@Context.Request.Query["search"]" placeholder="Mã đơn, tên hoặc email" /></form><form class="filter-admin"><select name="status" onchange="this.form.submit()"><option value="">Tất cả trạng thái</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(Context.Request.Query["status"] == status.ToString())">@status.ToOrderStatusText()</option> }</select></form></div><div class="admin-card table-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Đơn hàng</th><th>Khách hàng</th><th>Thanh toán</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><a asp-action="Details" asp-route-id="@order.Id"><strong>#@order.OrderCode</strong><small>@order.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</small></a></td><td><strong>@order.CustomerName</strong><small>@order.Email</small></td><td><partial name="_PaymentStatusBadge" model="order.PaymentStatus" /><small class="d-block mt-1">@(order.PaymentMethod == PaymentMethod.COD ? "COD" : "VNPay")</small></td><td><strong>@order.TotalAmount.ToMoney()</strong></td><td><partial name="_OrderStatusBadge" model="order.OrderStatus" /></td><td><a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@order.Id"><i class="bi bi-chevron-right"></i></a></td></tr> }</tbody></table></div></div>
