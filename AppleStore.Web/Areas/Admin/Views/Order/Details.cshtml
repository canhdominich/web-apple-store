@model Order
@{ ViewData["Title"] = $"Đơn hàng #{Model.OrderCode}"; }
<div class="d-flex justify-content-between align-items-center mb-4"><a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Tất cả đơn hàng</a><div><partial name="_OrderStatusBadge" model="Model.OrderStatus" /> <partial name="_PaymentStatusBadge" model="Model.PaymentStatus" /></div></div><div class="row g-4"><div class="col-lg-8"><div class="admin-card"><div class="admin-card-title"><div><span class="text-muted small">Mã đơn hàng</span><h2 class="h5 mb-0">#@Model.OrderCode</h2></div><span class="text-muted small">@Model.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</span></div>@foreach (var item in Model.OrderDetails) { <div class="order-detail-item"><img src="/images/products/placeholder.svg" alt="" /><div class="flex-grow-1"><strong>@item.ProductName</strong><span>@item.VariantName · @item.SKU · SL: @item.Quantity</span></div><strong>@item.TotalPrice.ToMoney()</strong></div> }<div class="admin-totals mt-4"><div><span>Tạm tính</span><strong>@Model.Subtotal.ToMoney()</strong></div><div><span>Phí giao hàng</span><strong>@Model.ShippingFee.ToMoney()</strong></div><div class="total"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToMoney()</strong></div></div></div><div class="admin-card mt-4"><h2 class="h6 mb-3">Lịch sử thanh toán</h2>@foreach (var payment in Model.Payments.OrderByDescending(x => x.CreatedDate)) { <div class="payment-history"><div><strong>@payment.Provider · @payment.TxnRef</strong><small>@payment.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm") · Response: @payment.ResponseCode · Bank: @payment.BankCode</small></div><div class="text-end"><partial name="_PaymentStatusBadge" model="payment.Status" /><small class="d-block">@payment.TransactionNo</small></div></div> }</div></div><div class="col-lg-4"><div class="admin-card"><h2 class="h6 mb-3">Thông tin khách hàng</h2><dl class="info-list"><dt>Họ tên</dt><dd>@Model.CustomerName</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Số điện thoại</dt><dd>@Model.PhoneNumber</dd><dt>Địa chỉ giao hàng</dt><dd>@Model.ShippingAddress</dd><dt>Ghi chú</dt><dd>@Model.Note</dd></dl></div><div class="admin-card mt-4"><h2 class="h6 mb-3">Cập nhật trạng thái</h2><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><select class="form-select mb-3" name="status">@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(status == Model.OrderStatus)">@status.ToOrderStatusText()</option> }</select><button class="btn btn-primary w-100">Lưu trạng thái</button></form></div></div></div>
