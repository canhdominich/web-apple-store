@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var title = ViewData["Title"]?.ToString() ?? "Dashboard";
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var adminName = User.Identity?.Name ?? "Admin";
    var avatar = adminName.Length > 0 ? adminName[..1].ToUpperInvariant() : "A";
    var unreadNotifications = 0;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title - Admin Apple Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/design-system.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin/admin-design-system.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/dropdown.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="admin-body">
    <aside class="admin-sidebar">
        <a class="brand-mark text-white d-block" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-dot"></span>apple<span>store</span></a>
        <div class="sidebar-label">TỔNG QUAN</div>
        <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
        <div class="sidebar-label mt-4">QUẢN LÝ</div>
        <a class="@Active("Order")" asp-area="Admin" asp-controller="Order" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng</a>
        <a class="@Active("Product")" asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Sản phẩm</a>
        <a class="@Active("Category")" asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="bi bi-collection"></i> Danh mục</a>
        <a class="@Active("Customer")" asp-area="Admin" asp-controller="Customer" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a>
        <div class="sidebar-label mt-4">HỆ THỐNG</div>
        <div class="sidebar-bottom">
            <a asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Về cửa hàng</a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
            </form>
        </div>
    </aside>
    <main class="admin-main">
        <header class="admin-topbar">
            <button class="btn d-lg-none" id="admin-menu" type="button" aria-label="Mở menu"><i class="bi bi-list"></i></button>
            <div>
                <div class="admin-breadcrumb">Khu vực quản trị / @title</div>
                <h1>@title</h1>
            </div>
            <div class="admin-actions">
                <button class="admin-icon-button admin-notification-button" type="button" aria-label="Thông báo">
                    <i class="bi bi-bell"></i>
                    @if (unreadNotifications > 0)
                    {
                        <span class="admin-notification-badge" aria-label="@unreadNotifications thông báo chưa đọc">@unreadNotifications</span>
                    }
                </button>
                <div class="dropdown">
                    <button class="admin-avatar" type="button" data-bs-toggle="dropdown" aria-expanded="false">@avatar</button>
                    <ul class="dropdown-menu dropdown-menu-end app-dropdown">
                        <li><span class="dropdown-item-text small text-muted">@adminName</span></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i>Hồ sơ</a></li>
                        <li><span class="dropdown-item disabled" aria-disabled="true"><i class="bi bi-gear"></i>Cài đặt</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i>Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <div class="admin-content">
            @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
            @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
            @RenderBody()
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/components/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
