@model ApplicationUser
@{ ViewData["Title"] = "Chi tiết khách hàng"; }
<div class="admin-card customer-detail-card"><div class="customer-hero"><span>@Model.FullName.Substring(0,1).ToUpperInvariant()</span><div><h2 class="h5">@Model.FullName</h2><p>@Model.Email · @Model.PhoneNumber</p></div></div><dl class="row info-list mt-4"><dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@Model.Address</dd><dt class="col-sm-3">Ngày tham gia</dt><dd class="col-sm-9">@Model.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</dd></dl></div><div class="admin-card table-card mt-4"><h2 class="h6 p-3 mb-0">Lịch sử đơn hàng</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var order in Model.Orders.OrderByDescending(x => x.CreatedDate)) { <tr><td><a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">#@order.OrderCode</a></td><td>@order.CreatedDate.ToVietnamTime().ToString("dd/MM/yyyy")</td><td>@order.TotalAmount.ToMoney()</td><td><partial name="_OrderStatusBadge" model="order.OrderStatus" /></td></tr> }</tbody></table></div></div>
