@model IReadOnlyList<Product>
@{ ViewData["Title"] = "Sản phẩm"; }
<div class="admin-toolbar"><form class="search-admin"><i class="bi bi-search"></i><input name="search" value="@Context.Request.Query["search"]" placeholder="Tìm sản phẩm" /></form><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Thêm sản phẩm</a></div><div class="admin-card table-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá từ</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><div class="admin-product"><img src="@(item.ImageThumbnail ?? "/images/products/placeholder.svg")" alt="" /><div><strong>@item.Name</strong><small>@item.Variants.Count phiên bản</small></div></div></td><td>@item.Category?.Name</td><td>@(item.Variants.Any() ? item.Variants.Min(x => x.Price).ToMoney() : item.BasePrice.ToMoney())</td><td>@item.Variants.Sum(x => x.StockQuantity)</td><td><span class="admin-status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Đang bán" : "Đã tắt")</span></td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a><form class="d-inline" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-light"><i class="bi bi-power"></i></button></form></td></tr> }</tbody></table></div></div>
